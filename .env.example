# Optional: link to Pretoria campus. Shown in header, mobile menu, footer.
# NEXT_PUBLIC_SISTER_SCHOOL_URL=https://your-pretoria-campus.vercel.app
# NEXT_PUBLIC_SISTER_SCHOOL_LABEL=Pretoria campus

# Optional: canonical site URL for security origin checks (production custom domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Postgres (recommended for 3,000+ applications) ──────────────────────────
# Vercel: Storage → Postgres → connect project (sets POSTGRES_URL automatically).
# Then run once locally or in CI: npm run db:init
# POSTGRES_URL=postgres://...

# Contact + online admissions use Web3Forms (https://web3forms.com).
# Forms submit through /api/* so keys stay on the server (not exposed in the browser).
# With Postgres connected, every submission is stored securely first; email is a backup alert.
#
# 1. Go to https://web3forms.com and create an access key with:
#    asamathsinstituteoflearning@gmail.com
# 2. Copy the access key from your email
# 3. Add to Vercel → Project → Settings → Environment Variables → Production (and Preview)
#
# Recommended (server-only — keeps the key out of the public JavaScript bundle):
WEB3FORMS_ACCESS_KEY=your-access-key-here
#
# Legacy fallback only (not required when WEB3FORMS_ACCESS_KEY is set):
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Optional: Google Maps embed on Contact / About (otherwise OpenStreetMap is used).
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-google-maps-key
