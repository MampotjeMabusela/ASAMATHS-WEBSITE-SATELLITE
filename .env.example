# Optional: link to Pretoria campus. Shown in header, mobile menu, footer.
# NEXT_PUBLIC_SISTER_SCHOOL_URL=https://your-pretoria-campus.vercel.app
# NEXT_PUBLIC_SISTER_SCHOOL_LABEL=Pretoria campus

# Optional: canonical site URL for security origin checks (production custom domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Postgres (optional) ─────────────────────────────────────────────────────
# POSTGRES_URL=postgres://...

# Contact + online admissions — Web3Forms (https://web3forms.com)
# Applications submit as plain text (JSON), same as Contact — no PDF attachments.
#
# 1. Create an access key at https://web3forms.com for asamathsinstituteoflearning@gmail.com
# 2. Add to Vercel → Environment Variables → Production (and Preview)
#
# Required for browser submit (Contact + Applications):
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here
#
# Optional server-only fallback for /api routes:
# WEB3FORMS_ACCESS_KEY=your-access-key-here

# Optional: Google Maps embed on Contact / About (otherwise OpenStreetMap is used).
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-google-maps-key
